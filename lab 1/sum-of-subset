#include <iostream>
#include <vector>

using namespace std;

void findSubsets(int index, int target, vector<int>& nums, vector<int>& current) {
    if (target == 0) {
        cout << "[ ";
        for (int x : current) cout << x << " ";
        cout << "]\n";
        return;
    }
    
    for (int i = index; i < nums.size(); i++) {
        if (nums[i] <= target) {
            current.push_back(nums[i]);
            findSubsets(i + 1, target - nums[i], nums, current);
            current.pop_back();
        }
    }
}

int main() {
    vector<int> nums = {10, 7, 5, 18, 12, 20, 15};
    int target = 35;
    vector<int> current;

    findSubsets(0, target, nums, current);
    
    return 0;
}
