#include <iostream>
#include <vector>
#include <string>

using namespace std;

const int ALPHABET_SIZE = 256;

void buildBadCharTable(string pattern, vector<int>& badChar) {
    int m = pattern.length();
    
    for (int i = 0; i < ALPHABET_SIZE; i++) {
        badChar[i] = -1;
    }

    for (int i = 0; i < m; i++) {
        badChar[(int)pattern[i]] = i;
    }
}

void boyerMooreSearch(string text, string pattern) {
    int n = text.length();
    int m = pattern.length();

    if (m == 0 || n == 0 || m > n) return;

    vector<int> badChar(ALPHABET_SIZE);
    buildBadCharTable(pattern, badChar);

    int s = 0; 

    while (s <= (n - m)) {
        int j = m - 1;

        while (j >= 0 && pattern[j] == text[s + j]) {
            j--;
        }

        if (j < 0) {
            cout << "Pattern found at index " << s << "\n";
            s += (s + m < n) ? m - badChar[text[s + m]] : 1;
        } else {
            s += max(1, j - badChar[text[s + j]]);
        }
    }
}

int main() {
    string text = "ABAAABCDABCDECAMCABC";
    string pattern = "ABC";
    
    cout << "Text: " << text << "\n";
    cout << "Pattern: " << pattern << "\n\n";
    
    boyerMooreSearch(text, pattern);
    
    return 0;
}
